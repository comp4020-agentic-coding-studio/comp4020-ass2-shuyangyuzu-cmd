---
import ContentLayout from "../../layouts/PageLayout.astro";
import Callout from "astro-theme-university/components/Callout.astro";
import { withBase } from "astro-theme-university/url";
import { siteConfig } from "../../site-config";
import {
  POLICIES,
  SCENARIOS,
  simulate,
  type PolicyName,
  type ScenarioName,
  type SimulationResult,
} from "../../lib/policy-lab/simulate";

const SCENARIO_NAMES = Object.keys(SCENARIOS) as ScenarioName[];

const POLICY_LABELS: Record<PolicyName, string> = {
  FCFS: "FCFS",
  QUICK_ENQUIRIES: "Quick Enquiries",
  PRIORITY_LANE: "Priority Lane",
};

const POLICY_DESCRIPTIONS: Record<PolicyName, string> = {
  FCFS: "Strict arrival order.",
  QUICK_ENQUIRIES: "Shortest service time first, ignoring any declared priority.",
  PRIORITY_LANE:
    "Self-declared-urgent tickets served first as a group, then shortest first within whichever group is served.",
};

function slugify(value: string): string {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

/** Rounds to 2 decimal places for display, matching POLICY-LAB-CONTRACT.md's table. */
function fmt(value: number): string {
  return String(Math.round(value * 100) / 100);
}

const allResults: Record<ScenarioName, Record<PolicyName, SimulationResult>> = Object.fromEntries(
  SCENARIO_NAMES.map((scenarioName) => {
    const { tickets, closedWindow } = SCENARIOS[scenarioName];
    return [
      scenarioName,
      Object.fromEntries(
        POLICIES.map((policy) => [policy, simulate(tickets, closedWindow, policy)]),
      ) as Record<PolicyName, SimulationResult>,
    ];
  }),
) as Record<ScenarioName, Record<PolicyName, SimulationResult>>;

const DEFAULT_SCENARIO: ScenarioName = "Normal Day";
const DEFAULT_POLICY: PolicyName = "FCFS";
const defaultResult = allResults[DEFAULT_SCENARIO][DEFAULT_POLICY];
const defaultTickets = [...defaultResult.tickets].sort((a, b) => a.serviceOrder - b.serviceOrder);

// Serialised once at build time from the same simulate() call above, so the
// client-side picker below never has its own copy of the algorithm and can
// never disagree with the tables rendered on this page.
const clientData = JSON.stringify(allResults).replace(/</g, "\\u003c");

// Figures used in the memo and reflection questions, pulled from the same
// computed results so neither can drift from what the tables actually show.
const ndFcfs = allResults["Normal Day"].FCFS.summary;
const ndPriority = allResults["Normal Day"].PRIORITY_LANE.summary;
const hdQuick = allResults["High-declaration Day"].QUICK_ENQUIRIES.summary;
const hdPriority = allResults["High-declaration Day"].PRIORITY_LANE.summary;
const ssFcfs = allResults["System Shock"].FCFS.summary;
const ssQuick = allResults["System Shock"].QUICK_ENQUIRIES.summary;
const ssPriority = allResults["System Shock"].PRIORITY_LANE.summary;
---

<ContentLayout
  title="Policy Lab"
  description="Same tickets. Three rules. See who waits longer when the policy changes."
  {...siteConfig}
>
  <section aria-labelledby="policy-lab-live-heading">
    <h2 id="policy-lab-live-heading">Choose the next rule</h2>
    <p>
      Choose a synthetic case and compare the cost of each rule. Times are
      in minutes. Every ticket is served; nobody leaves these fixed queues.
    </p>

    <form id="policy-lab-form" class="policy-lab-controls">
      <fieldset>
        <legend>Scenario</legend>
        {
          SCENARIO_NAMES.map((name) => (
            <label class="policy-lab-choice">
              <input type="radio" name="scenario" value={name} checked={name === DEFAULT_SCENARIO} />
              {name}
            </label>
          ))
        }
      </fieldset>

      <fieldset>
        <legend>Policy</legend>
        {
          POLICIES.map((policy) => (
            <label class="policy-lab-choice">
              <input type="radio" name="policy" value={policy} checked={policy === DEFAULT_POLICY} />
              {POLICY_LABELS[policy]}
            </label>
          ))
        }
      </fieldset>

      <div class="policy-lab-actions">
        <button type="reset" class="at-button at-button--outline at-button--small">
          Reset to Normal Day / FCFS
        </button>
      </div>
    </form>

    <p id="policy-lab-status" role="status" aria-live="polite" class="policy-lab-status"></p>

    <div class="policy-result">
      <h3 id="policy-lab-selection-heading">{DEFAULT_SCENARIO} — {POLICY_LABELS[DEFAULT_POLICY]}</h3>
      <dl class="policy-metrics" id="policy-lab-metrics">
        <div><dt>Mean wait</dt><dd><span data-metric="meanWait">{fmt(defaultResult.summary.meanWait)}</span> <small>min</small></dd></div>
        <div><dt>Median wait</dt><dd><span data-metric="medianWait">{defaultResult.summary.medianWait}</span> <small>min</small></dd></div>
        <div><dt>Longest wait</dt><dd><span data-metric="maxWait">{defaultResult.summary.maxWait}</span> <small>min</small></dd></div>
        <div><dt>Tickets waiting &gt; 5 min</dt><dd data-metric="waitOverFiveCount">{defaultResult.summary.waitOverFiveCount}</dd></div>
        <div><dt>Overtaking events</dt><dd data-metric="overtakingTotal">{defaultResult.summary.overtakingTotal}</dd></div>
      </dl>
      <p class="office-label">Service order / first to last</p>
      <ol id="policy-lab-sequence" class="policy-sequence" aria-label="Tickets in service order">
        {defaultTickets.map((ticket) => <li>{ticket.id}</li>)}
      </ol>
      <p class="policy-sequence-note">Overtaking counts each later-arriving ticket served ahead of an earlier one. It is not a count of unique people.</p>
    </div>

    <details id="policy-lab-compare" class="at-callout at-callout--details">
      <summary>Compare all policies for {DEFAULT_SCENARIO}</summary>
      <p>No ranking is implied — these are the same five figures, side by side, for one scenario.</p>
      <p class="policy-lab-scroll-hint">Scroll the table horizontally to see every column.</p>
      <div class="at-table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Policy</th>
              <th scope="col">Mean wait</th>
              <th scope="col">Median wait</th>
              <th scope="col">Max wait</th>
              <th scope="col">Wait &gt; 5 min</th>
              <th scope="col">Overtaking total</th>
            </tr>
          </thead>
          <tbody id="policy-lab-compare-body">
            {
              POLICIES.map((policy) => {
                const s = allResults[DEFAULT_SCENARIO][policy].summary;
                return (
                  <tr>
                    <td>{POLICY_LABELS[policy]}</td>
                    <td>{fmt(s.meanWait)}</td>
                    <td>{s.medianWait}</td>
                    <td>{s.maxWait}</td>
                    <td>{s.waitOverFiveCount}</td>
                    <td>{s.overtakingTotal}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </details>

    <p>Service order and per-ticket detail for the selected policy — the individual variance behind the averages above:</p>

    <p class="policy-lab-scroll-hint">Scroll the table horizontally to see every column.</p>
    <div class="at-table-wrap">
      <table id="policy-lab-ticket-table">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Category</th>
            <th scope="col">Declared</th>
            <th scope="col">Arrival</th>
            <th scope="col">Order</th>
            <th scope="col">Start</th>
            <th scope="col">Completion</th>
            <th scope="col">Wait</th>
            <th scope="col">Overtaking</th>
          </tr>
        </thead>
        <tbody id="policy-lab-ticket-body">
          {
            defaultTickets.map((ticket) => (
              <tr>
                <td>{ticket.id}</td>
                <td>{ticket.category}</td>
                <td>{ticket.declaredPriority ? "Yes" : "No"}</td>
                <td>{ticket.arrivalMinute}</td>
                <td>{ticket.serviceOrder}</td>
                <td>{ticket.start}</td>
                <td>{ticket.completion}</td>
                <td>{ticket.wait}</td>
                <td>{ticket.overtaking}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <details class="at-callout at-callout--details">
      <summary>Why this lab?</summary>
      <p>
        Waiting is not just absence of service — it allocates attention, risk
        and priority, and the ordering policy decides who gets which. Week 6
        asked you to compute three policies by hand against one log; this lab
        runs the same three policies — <a href={withBase("/sessions/week-06/")}>FCFS, Quick Enquiries and the Priority Lane</a> —
        against three fixed scenarios, so you can see the per-ticket variance
        a summary statistic hides, not just the summary itself.
      </p>
    </details>
  </section>

  <Callout type="info">
    <p>
      <strong>Office of Everything file — synthetic case material.</strong>
      Circulated to the queue-policy working group after the Policy Lab's first
      test run.
    </p>
    <p>
      On the Normal Day log, mean wait was {fmt(ndFcfs.meanWait)} minutes under
      FCFS and {fmt(ndPriority.meanWait)} minutes under the Priority Lane —
      the same rounded figure — while the Priority Lane produced {ndPriority.overtakingTotal} overtaking
      events, and FCFS produced none, by construction. One later ticket can
      overtake several earlier tickets. An unchanged mean can describe two very
      different queues.
    </p>
    <p>
      On High-declaration Day, where most tickets declare urgency, Quick
      Enquiries and the Priority Lane produced close mean waits ({fmt(hdQuick.meanWait)} and {fmt(hdPriority.meanWait)} minutes),
      and close overtaking totals ({hdQuick.overtakingTotal} and {hdPriority.overtakingTotal}).
      On System Shock, mean wait was lower under all three policies than on
      either other scenario ({fmt(ssFcfs.meanWait)}, {fmt(ssQuick.meanWait)} and {fmt(ssPriority.meanWait)} minutes for
      FCFS, Quick Enquiries and the Priority Lane). These are facts about six
      or eight fixed tickets on one fixed day each — not a finding about
      which policy performs best under real congestion, and not a claim this
      office is prepared to make about any other queue.
    </p>
  </Callout>

  <section aria-labelledby="policy-lab-reflect-heading">
    <h2 id="policy-lab-reflect-heading">Reflection</h2>
    <ol>
      <li>
        Expand Normal Day's Priority Lane table below. Its overtaking total is
        {" "}{ndPriority.overtakingTotal}, while FCFS's is always 0 by construction. Which
        specific ticket waited longest, and did it arrive early or late? Compare
        this with the defence you wrote for <a href={withBase("/sessions/week-06/")}>week 6</a> —
        would you still defend the same policy after reading the per-ticket
        table, not just the mean?
      </li>
      <li>
        High-declaration Day was built so most tickets declare priority. Under
        the Priority Lane, mean wait is {fmt(hdPriority.meanWait)} minutes versus {fmt(hdQuick.meanWait)} minutes
        under Quick Enquiries — close together. Given <a href={withBase("/sessions/week-10/")}>week 10</a>'s
        audit of self-declared urgency, what does a dataset where declaration
        is common do to the Priority Lane's actual selection power? Is a lane
        that almost everyone joins still a lane?
      </li>
      <li>
        System Shock blocks new service starts from minute 6 to minute 10;
        a ticket already in service still finishes. Expand all three System Shock tables
        below. Relative to <a href={withBase("/sessions/week-11/")}>week 11</a>'s worst-day
        case, would you expect the same ordering of outcomes to hold if the
        closed window were longer, or is that exactly the kind of
        generalisation the memo above warns against?
      </li>
      <li>
        The <a href={withBase("/assessments/policy-trial/")}>Policy Trial</a> (week 7) asks
        for a comparison like this one, once, on a dataset you declare
        yourself. <a href={withBase("/assessments/the-honest-queue/")}>The Honest Queue</a> (week
        12) asks you to defend an ordering policy against normal demand,
        congestion, uncertainty, failure and cancellation together. Which of
        the three fixed scenarios above most resembles the demand you plan to
        declare for your own Policy Trial dataset, and why?
      </li>
    </ol>
  </section>

  <section aria-labelledby="policy-lab-static-heading">
    <h2 id="policy-lab-static-heading">Browse every result without JavaScript</h2>
    <p>
      All nine scenario &times; policy combinations are available below.
      These tables remain available when the interactive picker cannot run.
    </p>

    {
      SCENARIO_NAMES.map((scenarioName) => {
        const closedWindow = SCENARIOS[scenarioName].closedWindow;
        return (
          <div class="policy-lab-scenario-block">
            <h3>
              {scenarioName}
              {closedWindow && (
                <span class="policy-lab-window-note">
                  {" "}
                  (closed to new starts from minute {closedWindow[0]} to {closedWindow[1]})
                </span>
              )}
            </h3>
            <p class="policy-lab-scroll-hint">Scroll the table horizontally to see every column.</p>
            <div class="at-table-wrap">
              <table>
                <caption>Compare all policies — {scenarioName}</caption>
                <thead>
                  <tr>
                    <th scope="col">Policy</th>
                    <th scope="col">Mean wait</th>
                    <th scope="col">Median wait</th>
                    <th scope="col">Max wait</th>
                    <th scope="col">Wait &gt; 5 min</th>
                    <th scope="col">Overtaking total</th>
                  </tr>
                </thead>
                <tbody>
                  {POLICIES.map((policy) => {
                    const s = allResults[scenarioName][policy].summary;
                    return (
                      <tr>
                        <td>{POLICY_LABELS[policy]}</td>
                        <td>{fmt(s.meanWait)}</td>
                        <td>{s.medianWait}</td>
                        <td>{s.maxWait}</td>
                        <td>{s.waitOverFiveCount}</td>
                        <td>{s.overtakingTotal}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            {POLICIES.map((policy) => {
              const result = allResults[scenarioName][policy];
              const sortedTickets = [...result.tickets].sort((a, b) => a.serviceOrder - b.serviceOrder);
              return (
                <details
                  id={`policy-lab-static-${slugify(scenarioName)}-${slugify(policy)}`}
                  class="at-callout at-callout--details"
                >
                  <summary>
                    {scenarioName} — {POLICY_LABELS[policy]}: per-ticket detail
                  </summary>
                  <p>{POLICY_DESCRIPTIONS[policy]}</p>
                  <p class="policy-lab-scroll-hint">Scroll the table horizontally to see every column.</p>
                  <div class="at-table-wrap">
                    <table>
                      <thead>
                        <tr>
                          <th scope="col">ID</th>
                          <th scope="col">Category</th>
                          <th scope="col">Declared</th>
                          <th scope="col">Arrival</th>
                          <th scope="col">Order</th>
                          <th scope="col">Start</th>
                          <th scope="col">Completion</th>
                          <th scope="col">Wait</th>
                          <th scope="col">Overtaking</th>
                        </tr>
                      </thead>
                      <tbody>
                        {sortedTickets.map((ticket) => (
                          <tr>
                            <td>{ticket.id}</td>
                            <td>{ticket.category}</td>
                            <td>{ticket.declaredPriority ? "Yes" : "No"}</td>
                            <td>{ticket.arrivalMinute}</td>
                            <td>{ticket.serviceOrder}</td>
                            <td>{ticket.start}</td>
                            <td>{ticket.completion}</td>
                            <td>{ticket.wait}</td>
                            <td>{ticket.overtaking}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </details>
              );
            })}
          </div>
        );
      })
    }
  </section>

  <script type="application/json" id="policy-lab-data" set:html={clientData} is:inline />

  <script>
    function initPolicyLab() {
    const dataEl = document.getElementById("policy-lab-data");
    const form = document.getElementById("policy-lab-form");
    const statusEl = document.getElementById("policy-lab-status");
    const headingEl = document.getElementById("policy-lab-selection-heading");
    const metrics = document.getElementById("policy-lab-metrics");
    const sequence = document.getElementById("policy-lab-sequence");
    const ticketBody = document.getElementById("policy-lab-ticket-body");
    const compareDetails = document.getElementById("policy-lab-compare");
    const compareBody = document.getElementById("policy-lab-compare-body");

    if (
      dataEl &&
      form instanceof HTMLFormElement &&
      statusEl &&
      headingEl &&
      metrics &&
      sequence &&
      ticketBody &&
      compareDetails &&
      compareBody
    ) {
      const allResults = JSON.parse(dataEl.textContent ?? "{}");
      const POLICY_LABELS: Record<string, string> = {
        FCFS: "FCFS",
        QUICK_ENQUIRIES: "Quick Enquiries",
        PRIORITY_LANE: "Priority Lane",
      };
      const POLICY_ORDER = ["FCFS", "QUICK_ENQUIRIES", "PRIORITY_LANE"];

      const fmt = (value: number) => String(Math.round(value * 100) / 100);

      const cell = (text: string | number) => {
        const td = document.createElement("td");
        td.textContent = String(text);
        return td;
      };

      const currentSelection = () => {
        const scenarioInput = form.querySelector<HTMLInputElement>('input[name="scenario"]:checked');
        const policyInput = form.querySelector<HTMLInputElement>('input[name="policy"]:checked');
        return {
          scenario: scenarioInput?.value ?? "Normal Day",
          policy: policyInput?.value ?? "FCFS",
        };
      };

      const render = (announce: boolean) => {
        const { scenario, policy } = currentSelection();
        const result = allResults[scenario][policy];
        const summary = result.summary;

        headingEl.textContent = `${scenario} — ${POLICY_LABELS[policy]}`;

        metrics.querySelectorAll<HTMLElement>("[data-metric]").forEach((metric) => {
          metric.textContent = fmt(summary[metric.dataset.metric!]);
        });

        ticketBody.replaceChildren();
        const tickets = [...result.tickets].sort(
          (a: { serviceOrder: number }, b: { serviceOrder: number }) => a.serviceOrder - b.serviceOrder,
        );
        sequence.replaceChildren();
        for (const ticket of tickets) {
          const stub = document.createElement("li");
          stub.textContent = ticket.id;
          sequence.append(stub);
          const row = document.createElement("tr");
          [
            ticket.id,
            ticket.category,
            ticket.declaredPriority ? "Yes" : "No",
            ticket.arrivalMinute,
            ticket.serviceOrder,
            ticket.start,
            ticket.completion,
            ticket.wait,
            ticket.overtaking,
          ].forEach((value) => row.append(cell(value)));
          ticketBody.append(row);
        }

        const compareSummary = compareDetails.querySelector("summary");
        if (compareSummary) {
          compareSummary.textContent = `Compare all policies for ${scenario}`;
        }
        compareBody.replaceChildren();
        for (const p of POLICY_ORDER) {
          const s = allResults[scenario][p].summary;
          const row = document.createElement("tr");
          [POLICY_LABELS[p], fmt(s.meanWait), s.medianWait, s.maxWait, s.waitOverFiveCount, s.overtakingTotal].forEach(
            (value) => row.append(cell(value)),
          );
          compareBody.append(row);
        }

        if (announce) {
          statusEl.textContent = `Showing ${scenario}, ${POLICY_LABELS[policy]}: mean wait ${fmt(summary.meanWait)} minutes, max ${summary.maxWait} minutes, ${summary.overtakingTotal} overtaking.`;
        }
      };

      // Astro navigation can revisit the page without running this module again.
      if (form.dataset.ready) { render(false); return; }
      form.dataset.ready = "true";
      form.addEventListener("change", (event) => {
        const target = event.target;
        if (target instanceof HTMLInputElement && (target.name === "scenario" || target.name === "policy")) {
          render(true);
        }
      });

      form.addEventListener("reset", () => {
        window.setTimeout(() => {
          render(false);
          statusEl.textContent = "Reset to Normal Day, FCFS.";
        }, 0);
      });

      // A reloaded or bfcache-restored page can leave a radio checked to a
      // non-default value while the server-rendered markup still shows the
      // default (Normal Day, FCFS) figures. Sync once on load so the visible
      // result always matches whichever inputs are actually checked, instead
      // of waiting for a future change event that may never fire if nothing
      // changes.
      render(false);
    }
    }
    initPolicyLab();
    document.addEventListener("astro:page-load", initPolicyLab);
    window.addEventListener("pageshow", initPolicyLab);
  </script>
</ContentLayout>
