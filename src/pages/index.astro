---
import { getCollection } from "astro:content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { withBase } from "astro-theme-university/url";
import { courseMeta } from "../course-config";
import { siteConfig } from "../site-config";
import { SCENARIOS, simulate } from "../lib/policy-lab/simulate";

const normalDay = SCENARIOS["Normal Day"];
const comparison = [
  { label: "First come, first served", rule: "Arrival order", result: simulate(normalDay.tickets, normalDay.closedWindow, "FCFS") },
  { label: "Quick Enquiries", rule: "Shortest eligible service first", result: simulate(normalDay.tickets, normalDay.closedWindow, "QUICK_ENQUIRIES") },
];
const fmt = (value: number) => Number(value.toFixed(2)).toString();
const dateLabel = (value: string) => new Intl.DateTimeFormat("en-AU", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(new Date(value));
const stages = [
  { weeks: "01–03", title: "Measure", question: "What does an average hide?", outcome: "Observe a queue. Account for the people behind the numbers.", href: "/lectures/week-01/" },
  { weeks: "04–06", title: "Choose", question: "Who gets to go next?", outcome: "Compare three rules. Name who gains and who waits longer.", href: "/lectures/week-04/" },
  { weeks: "07–09", title: "Communicate", question: "What can you honestly promise?", outcome: "Write the wait sign. Notice the people who leave.", href: "/lectures/week-07/" },
  { weeks: "10–12", title: "Defend", question: "Can your rule survive its worst day?", outcome: "Audit the priority lane. Redesign the counter and defend the cost.", href: "/lectures/week-10/" },
];
const outcomes: Record<string, string> = {
  "Queue Autopsy": "Observe one real waiting system. Separate what you saw from what you assumed.",
  "Policy Trial": "Compare two rules on the same declared data. Defend who goes next and who waits longer.",
  "The Honest Queue": "Redesign the Office of Everything. Explain its promises, its failures and the cost of your choices.",
};
const assessments = (await getCollection("assessments", ({ data }) => data.published !== false)).sort((a, b) => a.data.week - b.data.week);
---
<PageLayout landing title={courseMeta.title} description={courseMeta.description} {...siteConfig}>
  <div class="service-hall">
    <section class="hall-entrance" aria-labelledby="hall-title">
      <div class="hall-introduction">
        <p class="hall-label">{courseMeta.code} / {courseMeta.session} {courseMeta.year}</p>
        <h1 id="hall-title">{courseMeta.title}</h1>
        <p class="hall-subtitle">Twelve Weeks in the Architecture of Waiting</p>
        <p class="hall-claim">Everybody waits.<br />Not everybody waits equally.</p>
        <p class="hall-summary">One fictional university service desk. Twelve weeks to uncover who its rules favour, whose time they spend, and what you would change.</p>
        <div class="hall-actions">
          <a class="at-button" href={withBase("/policy-lab/")}>Enter the Policy Lab <span aria-hidden="true">↗</span></a>
          <a class="hall-text-link" href={withBase("/lectures/")}>Explore the twelve weeks <span aria-hidden="true">→</span></a>
        </div>
        <p class="hall-dates"><time datetime={courseMeta.startDate}>{dateLabel(courseMeta.startDate)}</time> – <time datetime={courseMeta.endDate}>{dateLabel(courseMeta.endDate)}</time></p>
        <p class="hall-footnote">Teaching ends 14 May; feedback and consolidation continue to 28 May. <a href={withBase("/policies/")}>Course calendar</a>.</p>
      </div>
      <figure class="hall-receipt" aria-label="Fictional course service receipt">
        <div class="receipt-top"><span>SlopU / Student services</span><span aria-hidden="true">↘</span></div>
        <p class="receipt-office">Office of<br />Everything</p>
        <p class="receipt-label">Course admission / retain for reference</p>
        <p class="receipt-code">{courseMeta.code}</p>
        <p class="receipt-counts">12 weeks / 3 policies / 1 service desk</p>
        <div class="receipt-rule" aria-hidden="true"></div>
        <blockquote>Please retain your ticket.<br />You may need it as evidence.</blockquote>
        <div class="receipt-footer"><span>Purpose: a defensible redesign</span><span aria-hidden="true">||| || ||| | ||||</span></div>
        <figcaption>Course illustration. Not a live queue.</figcaption>
      </figure>
    </section>

    <section class="hall-comparison" aria-labelledby="comparison-title">
      <header class="hall-section-heading"><p class="hall-label">Exhibit 01 / Normal Day</p><h2 id="comparison-title">Same arrivals. Different rules.<br />Different waits.</h2></header>
      <p>Eight tickets, one counter, two ways to decide who goes next. Synthetic teaching scenario; every ticket is eventually served.</p>
      <div class="hall-policy-pair">
        {comparison.map(({ label, rule, result }) => <section class="hall-policy" aria-label={label}>
          <p class="hall-label">{rule}</p><h3>{label}</h3>
          <dl>
            <div><dt>Mean wait</dt><dd>{fmt(result.summary.meanWait)} <small>min</small></dd></div>
            <div><dt>Longest wait</dt><dd>{fmt(result.summary.maxWait)} <small>min</small></dd></div>
            <div><dt>Overtaking events</dt><dd>{result.summary.overtakingTotal}</dd></div>
          </dl>
        </section>)}
      </div>
      <p class="hall-footnote">Overtaking counts each pair in which a later arrival starts service before an earlier arrival. These results describe this fixed scenario, not every queue.</p>
      <p class="hall-question">Which outcome would you defend—and whose wait would you have to explain?</p>
      <a class="hall-text-link" href={withBase("/policy-lab/")}>Inspect every ticket in the Policy Lab <span aria-hidden="true">→</span></a>
    </section>

    <section class="hall-curriculum" aria-labelledby="windows-title">
      <header class="hall-section-heading"><p class="hall-label">Your route through the office</p><h2 id="windows-title">Twelve weeks.<br />Four service windows.</h2></header>
      <p>The Office handles enrolment changes, printer-credit disputes and everything in between. Each week adds a memo, ticket log, complaint or failure to the same fictional case.</p>
      <ol class="hall-windows">
        {stages.map((stage, index) => <li>
          <div class="hall-window-number"><span aria-hidden="true">0{index + 1}</span><p class="hall-label">Window 0{index + 1}<br />Weeks {stage.weeks}</p></div>
          <h3><a href={withBase(stage.href)}>{stage.title}</a></h3>
          <p class="hall-window-question">{stage.question}</p><p>{stage.outcome}</p>
        </li>)}
      </ol>
      <p class="hall-footnote">Read the <a href={withBase("/lectures/")}>lectures</a>, then bring your decision to the <a href={withBase("/sessions/")}>weekly Queue Lab</a>.</p>
    </section>

    <section class="hall-assessments" aria-labelledby="outcomes-title">
      <header class="hall-section-heading"><p class="hall-label">Three submissions / one accumulating argument</p><h2 id="outcomes-title">Leave with more than a complaint.</h2></header>
      <CardGrid columns={3}>
        {assessments.map((assessment) => <Card title={assessment.data.title} href={`/assessments/${assessment.id}/`}>
          <p class="hall-assessment-weight">{assessment.data.weight}% <span> / Week {assessment.data.week}</span></p>
          <p>{outcomes[assessment.data.title] ?? assessment.data.description}</p>
        </Card>)}
      </CardGrid>
    </section>

    <div class="hall-reading">
      <section aria-labelledby="entry-title"><p class="hall-label">Before you take a ticket</p><h2 id="entry-title">Bring a question about a queue.</h2><p>You should be comfortable reading a small dataset. No queueing theory, statistics or systems-design background is assumed.</p><p>If you have ever wanted to explain exactly what is wrong with a waiting room, call centre or online queue, start here.</p></section>
      <section aria-labelledby="exit-title"><p class="hall-label">When your number is called</p><h2 id="exit-title">Make a change you can defend.</h2><p>By week 12, you can name what a waiting system measures, identify its ordering rule, explain who it favours, and propose a specific change—including what that change costs someone else.</p><a class="hall-text-link" href={withBase("/assessments/the-honest-queue/")}>Read The Honest Queue brief <span aria-hidden="true">→</span></a></section>
    </div>
    <footer class="hall-exit"><p class="hall-label">The counter is open. The rules are yours to question.</p><a class="at-button" href={withBase("/lectures/week-01/")}>Start with Week 01 <span aria-hidden="true">↗</span></a><p><a href={withBase("/people/")}>Teaching team</a> · <a href={withBase("/policies/")}>Course policies</a> · <a href={withBase("/assessments/")}>All assessments</a></p></footer>
  </div>
</PageLayout>
