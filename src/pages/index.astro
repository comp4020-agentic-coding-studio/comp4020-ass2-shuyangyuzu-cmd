---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "../layouts/PageLayout.astro";
import { withBase } from "astro-theme-university/url";
import heroImage from "../assets/images/hero-home.svg";
import { courseMeta } from "../course-config";
import { siteConfig } from "../site-config";

const stages = [
  { weeks: "01–03", title: "Measure", question: "What does an average hide?", outcome: "Observe a queue. Account for the people behind the numbers.", href: "/lectures/week-01/" },
  { weeks: "04–06", title: "Choose", question: "Who gets to go next?", outcome: "Compare three rules. Name who gains and who waits longer.", href: "/lectures/week-04/" },
  { weeks: "07–09", title: "Communicate", question: "What can you honestly promise?", outcome: "Write the wait sign. Notice the people who leave.", href: "/lectures/week-07/" },
  { weeks: "10–12", title: "Defend", question: "Can your rule survive its worst day?", outcome: "Audit the priority lane. Redesign the counter and defend the cost.", href: "/lectures/week-10/" },
];
---

<ContentLayout
  title={courseMeta.title}
  description="Everybody waits. Not everybody waits equally."
  heroImage={heroImage}
  heroImageAlt="Gold queue lines enter a single counter on a black field, beside the outline of a perforated ticket."
  {...siteConfig}
>
  <div class="office-register" aria-label="Course information">
    <span>{courseMeta.code} / Office of Everything</span>
    <span>{courseMeta.session} / {courseMeta.year}</span>
    <span>12 teaching weeks</span>
  </div>
  <p class="course-subtitle">Twelve Weeks in the Architecture of Waiting</p>
  <div class="office-actions">
    <a class="at-button" href={withBase("/lectures/week-01/")}>Begin with Week 01 <span aria-hidden="true">↗</span></a>
    <a class="at-button at-button--outline" href={withBase("/policy-lab/")}>Try the Policy Lab <span aria-hidden="true">→</span></a>
  </div>

  <section class="office-intro" aria-labelledby="course-premise">
    <div>
      <p class="office-label">The institution has a policy for your time.</p>
      <h2 id="course-premise">A queue is a decision.<br />Someone pays for it.</h2>
      <p>Waiting is one of the ways a system allocates service, risk, attention and
        priority. Learn who designed the queue, what it measures, and whose time
        it spends.</p>
      <p>Our case is the SlopU Office of Everything: one fictional counter for
        enrolment changes, printer-credit disputes and everything in between.
        Each week adds a memo, a ticket log, a complaint or a failure to the same
        file. By the end, you have to redesign the office — and answer for it.</p>
    </div>
    <aside class="office-ticket" aria-label="Course case file">
      <p class="office-label">Office of Everything / Case file</p>
      <dl>
        <div><dt>Reference</dt><dd>{courseMeta.code}</dd></div>
        <div><dt>Subject</dt><dd>The allocation of waiting</dd></div>
        <div><dt>Teaching period</dt><dd><time datetime={courseMeta.startDate}>22 Feb</time> – <time datetime={courseMeta.endDate}>28 May {courseMeta.year}</time></dd></div>
        <div><dt>Final outcome</dt><dd>A defensible redesign</dd></div>
      </dl>
      <p>Synthetic case material. The office is fictional. The decisions are yours.</p>
    </aside>
  </section>

  <h2>Twelve weeks. Four decisions.</h2>
  <ol class="office-stages">
    {stages.map((stage) => (
      <li>
        <p class="office-label">Weeks {stage.weeks}</p>
        <h3><a href={withBase(stage.href)}>{stage.title}</a></h3>
        <p><strong>{stage.question}</strong></p>
        <p>{stage.outcome}</p>
      </li>
    ))}
  </ol>

  <section class="office-lab-invite" aria-labelledby="lab-invitation">
    <p class="office-label">The policy desk / Interactive exercise</p>
    <h2 id="lab-invitation">Same arrivals. Different rules. Different waits.</h2>
    <p>First come, first served. Quick enquiries. A priority lane. Apply each
      rule to the same tickets, then look past the average to see who paid
      for the improvement.</p>
    <a class="at-button" href={withBase("/policy-lab/")}>Open the Policy Lab <span aria-hidden="true">→</span></a>
  </section>

  <div class="office-reading-grid">
    <section aria-labelledby="course-audience">
      <p class="office-label">Entry requirements</p>
      <h2 id="course-audience">Bring a question about a queue.</h2>
      <p>You should be comfortable reading a small dataset. No queueing theory,
        statistics or systems-design background is assumed. If you have ever
        wanted to explain exactly what is wrong with a waiting room, call centre
        or online queue, this is a place to start.</p>
    </section>
    <section aria-labelledby="course-outcome">
      <p class="office-label">On leaving the office</p>
      <h2 id="course-outcome">Make a change you can defend.</h2>
      <p>By week 12, you can name what a waiting system measures, identify the
        rule behind its ordering, explain who it favours, and propose a specific
        change — including what that change would cost someone else.</p>
    </section>
  </div>

  <h2>Find your next step</h2>
  <CardGrid columns={3}>
    <Card title="Lectures" href="/lectures/"><p>The twelve questions that build the course argument.</p><p><small>01 / Read the case</small></p></Card>
    <Card title="Queue Labs" href="/sessions/"><p>The weekly evidence, decisions and work to bring back.</p><p><small>02 / Test the rule</small></p></Card>
    <Card title="Assessment" href="/assessments/"><p>Three submissions: an autopsy, a trial and a redesign.</p><p><small>03 / Defend the decision</small></p></Card>
    <Card title="People" href="/people/"><p>Meet the convenor and tutor responsible for your case file.</p><p><small>04 / Find your teaching team</small></p></Card>
    <Card title="Policies" href="/policies/"><p>Accessibility, observation, sources, extensions and support.</p><p><small>05 / Read the conditions</small></p></Card>
  </CardGrid>
</ContentLayout>
